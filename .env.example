# If unset, deepagents defaults are used. Set this to force a model.
DEEP_AGENT_MODEL=anthropic:claude-sonnet-4-6

# Required by your chosen model provider.
# Msty graph uses fixed server profiles, independent of DEEP_AGENT_MODEL above.
MSTY_MODEL_PROFILE=luna
# Configure OPENAI_API_KEY and DEEPSEEK_API_KEY in deployment secrets, not Git.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...
